@model IEnumerable<Assignment1_EquipmentTool.Models.Equipment>

@{
    ViewData["Title"] = "All Equipment";
}

<h1>All Equipment</h1>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Id</th>
        <th>Type</th>
        <th>Description</th>
        <th>Available</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var equipment in Model)
    {
        <tr class="@(equipment.Available ? "table-success" : "table-danger")">
            <td>@equipment.Id</td>
            <td>@equipment.Type</td>
            <td>@equipment.Description</td>
            <td>@equipment.Available</td>
        </tr>
    }
    </tbody>
</table>